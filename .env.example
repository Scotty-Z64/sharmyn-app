# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Owner portal ───────────────────────────────────────────────
ADMIN_PASSWORD=

# ── Optional integrations (see docs/environment.md) ────────────
OWNER_EMAIL=
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
OWNER_WHATSAPP=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
CRON_SECRET=
PHOTOROOM_API_KEY=
META_ACCESS_TOKEN=
META_IG_USER_ID=

# Optional: shows a payment countdown on the owner portal until this date-time (ISO). Remove to hide it.
PAYMENT_NOTICE_DEADLINE=
PAYMENT_NOTICE_AMOUNT=
